# Ghost backend (Ghost Admin → Settings → Integrations → Add custom integration → Content API key)
GHOST_URL=https://management-of.closetrepublic.com
GHOST_CONTENT_API_KEY=

# Ministry of Finance page: your Buy Me a Coffee page and the button text
NEXT_PUBLIC_DONATE_URL=https://buymeacoffee.com/your-page
NEXT_PUBLIC_DONATE_LABEL=Buy me a compute
# Optional UPI ID for a "Pay by UPI" button, e.g. closetrepublic@okaxis
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Closet Republic

# Treasury (monthly budget + legal fund), stored in SQLite
DATABASE_PATH=./data/closet-republic.db
FUNDING_CURRENCY=INR
# Month boundaries for the monthly budget reset
FUNDING_TIMEZONE=Asia/Kolkata
# Starting goals; change them later on /admin
FUNDING_GOAL=
LEGAL_FUND_GOAL=

# Buy Me a Coffee → Settings → Webhooks: secret for https://<your site>/api/webhooks/buymeacoffee
BMC_WEBHOOK_SECRET=
# Converts other currencies into FUNDING_CURRENCY, e.g. USD=84,EUR=91
BMC_EXCHANGE_RATES=USD=84
# Set to true while testing with Buy Me a Coffee's "send test" events
BMC_ACCEPT_TEST_EVENTS=false

# Admin page (/admin) and admin API: a long random secret, at least 16 characters
ADMIN_TOKEN=
