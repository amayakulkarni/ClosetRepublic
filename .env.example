# Ghost backend (Ghost Admin → Settings → Integrations → Add custom integration → Content API key)
GHOST_URL=https://management-of.closetrepublic.com
GHOST_CONTENT_API_KEY=

# Ministry of Finance page: the Buy Me a Coffee page and the button text
NEXT_PUBLIC_DONATE_URL=https://buymeacoffee.com/<page>
NEXT_PUBLIC_DONATE_LABEL=Buy me a compute
# Optional UPI ID for a "Pay by UPI" button, e.g. closetrepublic@okaxis
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Closet Republic

# Treasury (monthly budget + legal, welfare and infrastructure funds), stored in SQLite.
# Welfare and infrastructure goals and the welfare split are set on /admin.
DATABASE_PATH=./data/closet-republic.db
FUNDING_CURRENCY=INR
# Month boundaries for the monthly budget reset
FUNDING_TIMEZONE=Asia/Kolkata
# Starting goals; change them later on /admin
FUNDING_GOAL=
LEGAL_FUND_GOAL=

# Buy Me a Coffee → Settings → Webhooks: secret for https://<site>/api/webhooks/buymeacoffee
BMC_WEBHOOK_SECRET=
# Converts other currencies into FUNDING_CURRENCY, e.g. USD=84,EUR=91
BMC_EXCHANGE_RATES=USD=84
# Set to true while testing with Buy Me a Coffee's "send test" events
BMC_ACCEPT_TEST_EVENTS=false

# GitHub Sponsors: the button on /funding and /development, and the webhook secret
# (github.com/sponsors/<account>/dashboard → Webhooks). Sponsorships are in USD and are
# converted with EXCHANGE_RATES.
NEXT_PUBLIC_GITHUB_SPONSORS_URL=
GITHUB_SPONSORS_WEBHOOK_SECRET=
EXCHANGE_RATES=USD=84

# Admin page (/admin) and admin API: a long random secret, at least 16 characters
ADMIN_TOKEN=

# Community places where ideas are shared in public (shown on the /development tabs).
# Reddit: leave empty until it exists; the site shows "link coming soon".
# Forum: empty means Stage (NEXT_PUBLIC_STAGE_URL).
COMMUNITY_REDDIT_URL=
COMMUNITY_FORUM_URL=
COMMUNITY_FORUM_NAME=Stage

# Stage, the community forum: navbar icon, homepage widget (recent public topics) and /development.
# Default https://stage.closetrepublic.com. Build-time variable: rebuild after changing it.
NEXT_PUBLIC_STAGE_URL=https://stage.closetrepublic.com

# Email (any SMTP provider). Leave SMTP_HOST empty to keep email off.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL); leave empty to decide from the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on every email, e.g. Closet Republic <hello@closetrepublic.com>
MAIL_FROM=
# Site owner's inbox: gets an alert for every new contributor, and receives contributors' replies
CONTRIBUTIONS_EMAIL=
# Optional: a different address for contributors' replies
MAIL_REPLY_TO=

# About and legal pages (content/pages/*.md). Set these before publishing the legal pages.
# LEGAL_EMAIL defaults to MAIL_REPLY_TO, then CONTRIBUTIONS_EMAIL.
LEGAL_EMAIL=
LEGAL_OPERATOR=
LEGAL_POSTAL_ADDRESS=
# Governing law and server location (default India)
LEGAL_COUNTRY=India
LEGAL_SERVER_COUNTRY=
# Next.js collects anonymous build telemetry unless this is set (the Privacy Policy says it is off)
NEXT_TELEMETRY_DISABLED=1

# Discord membership roles (bot/ and /discord/link). See the README, "Discord membership".
# The Discord application from discord.com/developers (the same "Republic Bot" app):
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Shared by the site and the bot (any long random string)
BOT_INTERNAL_SECRET=
BOT_PORT=40008
# Optional: Buy Me a Coffee developer token (read only) for the bot's hourly check
BMC_API_TOKEN=
# Optional: where members renew (defaults to NEXT_PUBLIC_DONATE_URL)
BMC_MEMBERSHIP_URL=
# Crypto memberships through BTCPay Server (deploy/btcpay). The button on /funding and the
# "Pay with crypto" section on /discord/link appear once all four are set.
# BTCPAY_URL can be the internal address, e.g. http://127.0.0.1:40009.
BTCPAY_URL=
BTCPAY_STORE_ID=
# Store > Access tokens > API key with only "Can create invoice" and "Can view invoices"
BTCPAY_API_KEY=
# Store > Webhooks > secret (payload URL https://closetrepublic.com/api/webhooks/btcpay)
BTCPAY_WEBHOOK_SECRET=

# Forum bridge (cr-bridge): every verified Buy Me a Coffee event is forwarded here
FORUM_BRIDGE_URL=
FORUM_BRIDGE_SECRET=
